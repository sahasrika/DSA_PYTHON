------max consicutive ones----
nums=[0,1,1,1,0,1,1,1,0,0,1,0]
n=len(nums)
count = 0
count1 = 0
for i in range(0,n):
  if nums[i] == 1:
    count+=1
  else:
    count = 0
  count1 = max(count , count1)
print(count1)
