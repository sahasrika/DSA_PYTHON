--------------2.Finding second largest number in array--------
nums=[52,32,-97,99,3,6,7]
print(max(nums))
n=len(nums)
maximum = nums[0]
for i in range(n):
  if nums[i]> maximum:
    maximum = nums[i]
print(maximum)
second_largest = float('-inf')
for j in range(n):
  if nums[j] > second_largest and nums[j] != maximum:
    second_largest = nums[j]
    print(second_largest)



------------------3.checking if the array is sorted or not--------
nums=[3,5,6,8,9,10,20]
n=len(nums)
for i in range(0,n-1):
  left=nums[i]
  right=nums[i+1]
if left < right:
  print("array is sorted")
else:
  print("array is not sorted")
