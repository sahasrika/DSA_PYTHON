----------BEST TIME TO BUY AND SELL STOCKS -----
prices = [7,1,3,6,9,1]
minimum = prices[0]
n=len(prices)
for i in range(0,n):
  if prices[i] < minimum:
    minimum = prices[i]
    minimum_index= i 
maximum = prices[minimum_index+1]
for j in range(maximum , n):
  if prices[j] > maximum:
    maximum = prices[j]
print(maximum)
------------OPTIMAL-----
prices = [7,1,3,6,9,1]
minimum = prices[0]
profit = 0
for i in range(1,len(prices)):
  if prices[i] < minimum:
    minimum = prices[i]
  profit = max (profit , prices[i]-minimum)
print(profit)
-------------- REARRANGING BASED ON SIGN ---------
nums = [5,10,-3,-1,-10,6]
n=len(nums)
result = [0] * n 
pos , neg = 0,1
for i in range(n):
    if nums[i] > 0 :
        result[pos]=nums[i]
        pos+=2
    else:
        result[neg]=nums[i]
        neg+=2
print (result)
